# Copy to `.env` (or `.env.local`) only to override the defaults below.

# The game's slug / id on Bloxity (My Games). Defaults to modern-guns.
# VITE_GAME_SLUG=modern-guns
# VITE_LEGION_GAME_ID=modern-guns

# Bloxity endpoints. Leave these as-is unless you are running the portal locally.
# They MUST be set: without them the SDK repoints itself at localhost when it
# detects a dev server, and the login popup can never return a token.
VITE_BLOXITY_PORTAL_URL=https://bloxity.io
VITE_BLOXITY_API_URL=https://api.bloxity.io

# Local / LAN play: the Colyseus game server (rust-server). Defaults to
# http://<this host>:3000. Setting it always skips the matchmaker.
# VITE_SERVER_URL=http://localhost:3000

# Hosted builds join through the Bloxity matchmaker (play.bloxity.io). CI sets this;
# pages on *.play.bloxity.io use it anyway.
# VITE_USE_MATCHMAKER=1
# A custom domain reaches the prod backend; set this to reach dev instead.
# VITE_LEGION_VERSION=preview
